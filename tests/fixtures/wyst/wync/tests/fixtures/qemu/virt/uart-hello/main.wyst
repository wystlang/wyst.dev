module hello

#target(arch = arm64-v8a, cpu = generic, el = 2)

import core.arch { cpu, exception }
import core.environment { semihost }

// homepage-example:start
/*
* QEMU `virt` is a generic virtual Arm board.
* Its PL011 UART provides serial text output.
*
* UART registers are memory-mapped I/O (MMIO):
* reads and writes at these addresses reach a
* device rather than ordinary RAM.
*
* A register address is UART0's base plus its
* PL011 byte offset. QEMU maps UART0's base at
* 0x0900_0000.
*/
register_map Pl011 {
  // DR is the data register.
  // DATA is its eight-bit transmit payload.
  DR: readwrite u32 at 0x00 {
    DATA: u8 at 0..=7
  }

  // FR is the flag register.
  // BUSY means the UART is still sending or receiving.
  // TXFF means the transmit FIFO is full.
  FR: readonly u32 at 0x18 {
    BUSY: bool at 3
    TXFF: bool at 5
  }

  // IBRD and FBRD hold the integer and fractional
  // parts of the baud-rate divisor.
  IBRD: readwrite u32 at 0x24 {
    DIVINT: u16 at 0..=15
  }
  FBRD: readwrite u32 at 0x28 {
    DIVFRAC: u8 at 0..=5
  }

  // LCR_H selects an eight-bit word and enables FIFOs.
  LCR_H: readwrite u32 at 0x2c {
    FEN: bool at 4
    WLEN: u8 at 5..=6
  }

  // CR enables the UART and its transmit and receive paths.
  CR: readwrite u32 at 0x30 {
    UARTEN: bool at 0
    TXE: bool at 8
    RXE: bool at 9
  }
}

mmio UART0: Pl011 at 0x0900_0000

/*
* There is no process runtime to call `main`. The
* layout file, similar to a linker script, names
* `_start` as the entry point. QEMU jumps here after
* loading the kernel image.
*
* QEMU passes a device-tree blob (DTB) address in Arm
* register `x0`; it describes the virtual hardware.
* `naked` omits the usual function prologue because
* no valid stack exists yet. `never` records that
* there is no caller to return to.
*/
// Put the entry address on a 16-byte boundary.
#[align(16)]
pub naked fn _start(dtb: @u8 in x0) -> never {
  // __stack_top is a linker-style symbol from the layout.
  // Set the CPU stack pointer to that reserved RAM.
  asm establishes stack (
    stack: u64 in x1 = __stack_top,
  ) {
    mov sp, stack
  }

  // The stack is ready, so ordinary function calls are safe.
  kernel_main(dtb)
}

fn kernel_main(dtb: @u8) -> never {
  // Production code would parse the DTB.
  // This fixture only checks that the handoff supplied it.
  if dtb == address<@u8>(0) {
    test_exit(0x63)
  }

  uart_init()
  uart_hello()

  // Bare metal has no caller to return to. `test_exit`
  // plays the role of process exit for this QEMU test:
  // report status 0, then stop the virtual machine.
  test_exit(0)
}

fn uart_init() {
  // Disable every path before changing the configuration.
  UART0.CR.write(UARTEN = false, TXE = false, RXE = false)

  // Finish any character left by earlier firmware, then
  // disable the FIFOs to flush them.
  while UART0.FR.read().BUSY {
    cpu.nop()
  }

  UART0.LCR_H.write(FEN = false)

  // QEMU supplies a 24 MHz UART clock. The PL011 divisor
  // for 115200 baud rounds to 13 + 1/64.
  UART0.IBRD.write(DIVINT = 13)
  UART0.FBRD.write(DIVFRAC = 1)

  // Use 8-bit words, one stop bit, no parity, and FIFOs.
  UART0.LCR_H.write(FEN = true, WLEN = 3)

  // This example only transmits, so leave the receiver off.
  UART0.CR.write(UARTEN = true, TXE = true, RXE = false)
}

fn uart_hello() {
  // `_` infers a fixed [6]u8 from the literal's decoded bytes.
  // The array has no runtime length field or trailing NUL byte.
  const msg: [_]u8 = "hello\n"

  // #len reads the inferred array length at compile time.
  for i in 0 ..< #len(msg) {
    uart_write(msg[i])
  }
}

fn uart_write(byte: u8) {
  // Poll for space in the transmit FIFO.
  while UART0.FR.read().TXFF {
    cpu.nop()
  }

  UART0.DR.write(DATA = byte)
}
// homepage-example:end
