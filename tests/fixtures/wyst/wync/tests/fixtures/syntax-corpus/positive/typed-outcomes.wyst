module syntax_outcomes

enum Stored: u8 {
  Empty
  Pair(u64, u64)
}

fn leaf(value: u64) -> u64 offers {
  terminal {
    failure(u8)
  }
} effects(none) {
  if value == 0 {
    fail 7
  }

  return value
}

fn forwarded(value: u64) -> u64 offers {
  terminal {
    failure(u8)
  }
} effects(none) {
  return leaf(value)?
}

fn pulse(value: u64) -> u64 offers handler(none) {
  progress(u64)
  terminal {
    failure(u8)
    cancelled(u16)
  }
} effects(none) {
  defer { }

  report value
  return value
}

fn handled(value: u64) -> u64 effects(none) {
  return handle pulse(value) {
    progress(_) { }
    terminal {
      failure(problem) {
        widen<u64>(problem)
      }
      cancelled(cause) {
        widen<u64>(cause)
      }
    }
  }
}

fn extracted(value: Stored) -> u64 effects(none) {
  return match value {
    .Empty {
      0
    }
    .Pair(left, right) {
      left + right
    }
  }
}
