{
  "name": "wyst.dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The wyst.dev homepage and the Wyst documentation",
  "scripts": {
    "build": "node build/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "serve": "node build/serve.mjs",
    "check:examples": "node tools/check-examples.mjs",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "markdown-it": "15.0.2",
    "markdown-it-anchor": "10.0.0",
    "prismjs": "1.30.0",
    "wrangler": "4.146.0"
  }
}
