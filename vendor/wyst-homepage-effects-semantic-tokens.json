    "text": "module keyboard_isr\n\n#target(arch = arm64-v8a, cpu = generic, el = 2)\n\nimport core.arch { cpu }\n\n#[deny_effects(interrupt_mask)]\nfn on_key_press(scancode: u8) -> u8 {\n  // This handler is not allowed to change the interrupt mask.\n  cpu.unmask(.irq)\n  return scancode\n}\n\npub naked fn _start(dtb: u64 in x0) -> never {\n  establish stack from __stack_top\n\n  loop { }\n}\n"
