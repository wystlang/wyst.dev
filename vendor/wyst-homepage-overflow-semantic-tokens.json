    "sha256": "6e096037f3689aa5a63aada3b56e6eb98f1f3aeb99604c57195c6649eb879c6d",
    "text": "module boot.overflow_guard\n\n#target(arch = arm64-v8a, cpu = generic, el = 2)\n\nimport core.arch { cpu }\n\nimport runtime.semihost { test_exit }\n\nconst UART0_BASE: u64 = 0x0900_0000\nconst UARTDR: @mmio u32 = address<@mmio u32>(UART0_BASE + 0x00)\nconst UARTFR: @mmio u32 = address<@mmio u32>(UART0_BASE + 0x18)\nconst TXFF: u32 = 0x20\n\npub naked fn _start(dtb: u64 in x0) -> never {\n  establish stack from __stack_top\n\n  if dtb == 0 {\n    test_exit(0x63)\n  }\n\n  kernel_main()\n}\n\nfn uart_write(byte: u8) {\n  while UARTFR.load() & TXFF != 0 {\n    cpu.nop()\n  }\n\n  UARTDR.store(widen<u32>(byte))\n}\n\nfn report_wrapped() -> never {\n  uart_write('w')\n  uart_write('r')\n  uart_write('a')\n  uart_write('p')\n  uart_write('p')\n  uart_write('e')\n  uart_write('d')\n  uart_write('\\n')\n  test_exit(0)\n}\n\n// C makes signed overflow undefined, so its compilers may assume x + 1 >= x\n// and discard this guard. Wyst's defined i32 wrapping is safer: every\n// optimization level must preserve the guard's intended behavior, avoiding\n// the class of security bugs where an overflow check silently disappears.\nfn is_at_max(x: i32) -> bool {\n  return x + 1 < x\n}\n\nfn kernel_main() -> never {\n  if is_at_max(0x7FFF_FFFF) {\n    report_wrapped()\n  }\n\n  test_exit(0x63)\n}\n"
